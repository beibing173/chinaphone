# 统一换行符，避免 Windows 提交导致 Linux CI 失败
* text=auto eol=lf

# Windows 批处理/脚本需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.exe binary
*.ico binary
*.jks binary
*.jar binary
*.png binary

# Gradle wrapper 必须是 LF
gradlew text eol=lf
gradlew.bat text eol=crlf
*.sh text eol=lf

# 文档保持 LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
